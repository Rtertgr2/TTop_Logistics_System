# ─── Database ──────────────────────────────────────────────────
POSTGRES_DB=logistics
POSTGRES_USER=logistics
POSTGRES_PASSWORD=your_secure_password_here

# ─── Google Maps API ──────────────────────────────────────────
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ─── LINE Messaging API (optional) ────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_DEFAULT_USER_ID=

# ─── Depot Location ───────────────────────────────────────────
DEPOT_ADDRESS=บริษัท ทรีท็อปเคมิคัลแอนด์ฟู้ดส์ คอร์ปอเรชั่น จำกัด
DEPOT_LAT=13.781882
DEPOT_LNG=100.425041

# ─── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ─── Security ─────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
API_KEYS=
ADMIN_KEYS=
DISPATCHER_KEYS=
PRODUCTION_MODE=false

# ─── Redis (production only) ──────────────────────────────────
REDIS_PASSWORD=

# ─── Traefik / SSL (production only) ─────────────────────────
ACME_EMAIL=

# ─── Grafana (production only) ────────────────────────────────
GRAFANA_PASSWORD=
GRAFANA_ADMIN_USER=admin

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── VRP Solver ───────────────────────────────────────────────
SOLVE_TIMEOUT_SECONDS=30
MAX_ROUTE_DISTANCE_KM=200
AVG_SPEED_KMH=30

# ─── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
