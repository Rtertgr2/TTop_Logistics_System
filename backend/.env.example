# Google Maps API (ใช้สำหรับ Geocoding และ Distance Matrix)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# LINE Messaging API (ใช้สำหรับส่ง notification ไปยังคนขับ)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_DEFAULT_USER_ID=your_line_user_id_here

# ที่ตั้งคลังสินค้า (Depot)
DEPOT_ADDRESS=บริษัท ทรีท็อปเคมิคัลแอนด์ฟู้ดส์ คอร์ปอเรชั่น จำกัด 20/2 ถนนบรมราชชนนี แขวงฉิมพลี เขตตลิ่งชัน กรุงเทพมหานคร 10170
DEPOT_LAT=13.781882
DEPOT_LNG=100.425041

# ขนาดไฟล์สูงสุด (MB)
MAX_FILE_SIZE_MB=10

# CORS (คั่นด้วย comma สำหรับหลาย origin)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
